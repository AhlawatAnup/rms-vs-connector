{
  "name": "rms-vs-connector",
  "displayName": "RMS VS Connector",
  "description": "Open-source distributed resource management platform for securely sharing CPU and GPU infrastructure over the internet. Manage compute resources, monitor usage, and launch workloads directly from VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:jupyterExplorer",
    "onCommand:rms-vs-connector.registerCloud"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rms-vs-connector.registerCloud",
        "title": "Register to Cloud"
      },
      {
        "command": "rms-vs-connector.openFile",
        "title": "Open File"
      },
      {
        "command": "rms-vs-connector.newFile",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "rms-vs-connector.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "rms-vs-connector.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "jupyterExplorer",
          "name": "Jupyter Files"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rms-vs-connector.newFile",
          "when": "view == jupyterExplorer",
          "group": "navigation"
        },
        {
          "command": "rms-vs-connector.newFolder",
          "when": "view == jupyterExplorer",
          "group": "navigation"
        },
        {
          "command": "rms-vs-connector.refresh",
          "when": "view == jupyterExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
