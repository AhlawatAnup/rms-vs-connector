{
  "name": "rms-vs-connector",
  "displayName": "RMS VS Connector",
  "description": "Open-source distributed resource management platform for securely sharing CPU and GPU infrastructure over the internet. Manage compute resources, monitor usage, and launch workloads directly from VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:jupyterExplorer",
    "onCommand:rms-vs-connector.registerCloud"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rms-vs-connector.registerCloud",
        "title": "Register to Cloud"
      },
      {
        "command": "rms-vs-connector.downloadFile",
        "title": "Download to Local Machine",
        "category": "Jupyter Cloud"
      },
      {
        "command": "rms-vs-connector.openTerminal",
        "title": "Open Cloud Terminal",
        "category": "Jupyter Cloud"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rms-vs-connector.downloadFile",
          "when": "resourceScheme == jupyterfs",
          "group": "6_copypath"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "rms-vs-connector.jupyterTerminal",
          "title": "Jupyter Cloud Terminal",
          "icon": "cloud"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
